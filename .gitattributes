# 统一换行：仓库内文本一律 LF
* text=auto eol=lf

# Windows 脚本需要 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制资源不做换行转换与 diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.zip binary
*.gz binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.db binary
*.sqlite binary
*.sqlite3 binary

# 锁文件折叠在 GitHub 语言统计之外
Cargo.lock linguist-generated=true
package-lock.json linguist-generated=true
